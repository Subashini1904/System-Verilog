class student;
  string name;
  int marks;
  function void display();
    $display("Name = %s, Marks = %0d", name, marks);
  endfunction
endclass
module test;
  initial begin
    student s1, s2;
    s1 = new();
    s1.name = "Priya";
    s1.marks = 90;
    s2 = s1;
    s2.marks = 95;
    s1.display();
    s2.display();
  end
endmodule


