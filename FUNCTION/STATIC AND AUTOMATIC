module test;
  function int static_counter();
    int count = 0;
    count++;
    return count;
  endfunction
  
  function automatic int auto_counter();
    int count = 0;
    count++;
    return count;
  endfunction

  initial begin
    $display("Static Call1 = %0d", static_counter());
    $display("Static Call2 = %0d", static_counter());
    $display("Static Call3 = %0d", static_counter());

    $display("Auto Call1 = %0d", auto_counter());
    $display("Auto Call2 = %0d", auto_counter());
    $display("Auto Call3 = %0d", auto_counter());
  end
endmodule



